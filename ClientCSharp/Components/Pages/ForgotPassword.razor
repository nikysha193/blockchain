@page "/forgot-password"
@rendermode InteractiveServer

@using System.Text.Json
@using ClientCSharp.Network

@inject AppState AppState

<PageTitle>Forgot Password</PageTitle>


<!-- ========================================= -->
<!-- SETTINGS -->
<!-- ========================================= -->

<div class="top-controls">

    <div class="settings-capsule @(showSettingsMenu ? "open" : "")">

        <div class="settings-capsule-content">

            <!-- Light / Dark -->
            <div class="theme-segment">

                <button type="button"
                        class="theme-choice @(!darkTheme ? "active" : "")"
                        @onclick="SetLightTheme">

                    <span class="sun-icon">☀</span>

                </button>

                <button type="button"
                        class="theme-choice @(darkTheme ? "active" : "")"
                        @onclick="SetDarkTheme">

                    <span class="moon-icon">☾</span>

                </button>

            </div>


            <div class="settings-divider"></div>


            <!-- Language -->
            <select class="settings-language-select"
                    @bind="currentLanguage"
                    @bind:after="ChangeLanguage">

                <option value="en">English</option>
                <option value="ru">Русский</option>
                <option value="he">עברית</option>

            </select>

        </div>


        <!-- Settings button -->
        <button type="button"
                class="settings-gear-button"
                @onclick="ToggleSettingsMenu">

            <svg class="settings-gear-icon"
                 viewBox="0 0 24 24"
                 fill="none">

                <path d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 0 0 2.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 0 0 1.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 0 0-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 0 0-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 0 0-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 0 0-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35A1.724 1.724 0 0 0 5.382 7.75c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.573-1.066Z"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round" />

                <path d="M12 15.25A3.25 3.25 0 1 0 12 8.75a3.25 3.25 0 0 0 0 6.5Z"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round" />

            </svg>

        </button>

    </div>

</div>


<!-- ========================================= -->
<!-- FORGOT PASSWORD PAGE -->
<!-- ========================================= -->

<div class="auth-layout @(darkTheme ? "dark" : "")">

    <div class="blockchain-art"
         aria-hidden="true">

        <div class="chain-block block-one">01</div>

        <div class="chain-line"></div>

        <div class="chain-block block-two">02</div>

        <div class="chain-line"></div>

        <div class="chain-block block-three">03</div>

    </div>


    <div class="login-container">

        <div class="security-badge">

            <span class="security-icon">◇</span>

            <span>@securityText</span>

        </div>


        <h1>@title</h1>

        <p class="subtitle">
            @subtitle
        </p>


        <!-- ================================= -->
        <!-- STEP 1 - EMAIL -->
        <!-- ================================= -->

        @if (recoveryStep == 1)
        {
            <form @onsubmit="RequestResetCode"
                  @onsubmit:preventDefault="true">

                <label for="email"
                       dir="@(currentLanguage == "he" ? "rtl" : "ltr")">

                    @emailLabel

                </label>


                <input type="email"
                       id="email"
                       @bind="email"
                       dir="@(currentLanguage == "he" ? "rtl" : "ltr")"
                       placeholder="@emailPlaceholder"
                       required />


                <button id="resetButton"
                        type="submit">

                    @sendCodeButtonText

                </button>

            </form>
        }


        <!-- ================================= -->
        <!-- STEP 2 - VERIFICATION CODE -->
        <!-- ================================= -->

        @if (recoveryStep == 2)
        {
            <form @onsubmit="VerifyCode"
                  @onsubmit:preventDefault="true">

                <label for="code"
                       dir="@(currentLanguage == "he" ? "rtl" : "ltr")">

                    @codeLabel

                </label>


                <input type="text"
                       id="code"
                       @bind="code"
                       inputmode="numeric"
                       maxlength="6"
                       placeholder="@codePlaceholder"
                       required />


                <button id="resetButton"
                        type="submit">

                    @verifyCodeButtonText

                </button>

            </form>
        }


        <!-- ================================= -->
        <!-- STEP 3 - NEW PASSWORD -->
        <!-- ================================= -->

        @if (recoveryStep == 3)
        {
            <form @onsubmit="ResetPassword"
                  @onsubmit:preventDefault="true">

                <label for="newPassword"
                       dir="@(currentLanguage == "he" ? "rtl" : "ltr")">

                    @newPasswordLabel

                </label>


                <input type="password"
                       id="newPassword"
                       @bind="newPassword"
                       dir="@(currentLanguage == "he" ? "rtl" : "ltr")"
                       placeholder="@newPasswordPlaceholder"
                       required />


                <label for="confirmPassword"
                       dir="@(currentLanguage == "he" ? "rtl" : "ltr")">

                    @confirmPasswordLabel

                </label>


                <input type="password"
                       id="confirmPassword"
                       @bind="confirmPassword"
                       dir="@(currentLanguage == "he" ? "rtl" : "ltr")"
                       placeholder="@confirmPasswordPlaceholder"
                       required />


                <button id="resetButton"
                        type="submit">

                    @changePasswordButtonText

                </button>

            </form>
        }


        <!-- ================================= -->
        <!-- STEP 4 - SUCCESS -->
        <!-- ================================= -->

        @if (recoveryStep == 4)
        {
            <p class="switch-page">

                <a href="/">
                    @loginNowText
                </a>

            </p>
        }


        <p id="message">@message</p>


        @if (recoveryStep != 4)
        {
            <p class="switch-page">

                <a href="/">
                    @backToLoginText
                </a>

            </p>
        }

    </div>

</div>


@code
{
    // ==========================================
    // LANGUAGE
    // ==========================================

    private string currentLanguage
    {
        get => AppState.Language;
        set => AppState.Language = value;
    }


    // ==========================================
    // THEME
    // ==========================================

    private bool darkTheme
    {
        get => AppState.DarkTheme;
        set => AppState.DarkTheme = value;
    }


    private bool showSettingsMenu = false;


    // ==========================================
    // RECOVERY STEP
    // ==========================================

    // 1 = Email
    // 2 = Verification Code
    // 3 = New Password
    // 4 = Success
    private int recoveryStep = 1;


    // ==========================================
    // FORM DATA
    // ==========================================

    private string email = "";

    private string code = "";

    private string newPassword = "";

    private string confirmPassword = "";


    // ==========================================
    // MESSAGE
    // ==========================================

    private string message = "";


    // ==========================================
    // PAGE TEXT
    // ==========================================

    private string securityText =
        "SECURE RECOVERY";

    private string title =
        "Reset Password";

    private string subtitle =
        "Enter your email to receive a verification code.";

    private string emailLabel =
        "Email";

    private string emailPlaceholder =
        "Enter your email";

    private string sendCodeButtonText =
        "Send Code";

    private string codeLabel =
        "Verification Code";

    private string codePlaceholder =
        "Enter 6-digit code";

    private string verifyCodeButtonText =
        "Verify Code";

    private string newPasswordLabel =
        "New Password";

    private string newPasswordPlaceholder =
        "Enter new password";

    private string confirmPasswordLabel =
        "Confirm New Password";

    private string confirmPasswordPlaceholder =
        "Enter new password again";

    private string changePasswordButtonText =
        "Change Password";

    private string backToLoginText =
        "← Back to Login";

    private string loginNowText =
        "Go to Login";


    // ==========================================
    // PAGE START
    // ==========================================

    protected override void OnInitialized()
    {
        ChangeLanguage();
    }


    // ==========================================
    // SETTINGS
    // ==========================================

    private void ToggleSettingsMenu()
    {
        showSettingsMenu =
            !showSettingsMenu;
    }


    private void SetLightTheme()
    {
        darkTheme = false;
    }


    private void SetDarkTheme()
    {
        darkTheme = true;
    }


    // ==========================================
    // LANGUAGE
    // ==========================================

    private void ChangeLanguage()
    {
        if (currentLanguage == "ru")
        {
            securityText =
                "БЕЗОПАСНОЕ ВОССТАНОВЛЕНИЕ";

            emailLabel =
                "Электронная почта";

            emailPlaceholder =
                "Введите ваш email";

            sendCodeButtonText =
                "Отправить код";

            codeLabel =
                "Код подтверждения";

            codePlaceholder =
                "Введите 6-значный код";

            verifyCodeButtonText =
                "Подтвердить код";

            newPasswordLabel =
                "Новый пароль";

            newPasswordPlaceholder =
                "Введите новый пароль";

            confirmPasswordLabel =
                "Подтвердите новый пароль";

            confirmPasswordPlaceholder =
                "Введите новый пароль ещё раз";

            changePasswordButtonText =
                "Изменить пароль";

            backToLoginText =
                "← Назад ко входу";

            loginNowText =
                "Перейти ко входу";


            if (recoveryStep == 1)
            {
                title =
                    "Восстановление пароля";

                subtitle =
                    "Введите ваш email, чтобы получить код подтверждения.";
            }

            if (recoveryStep == 2)
            {
                title =
                    "Подтверждение кода";

                subtitle =
                    "Введите 6-значный код подтверждения.";
            }

            if (recoveryStep == 3)
            {
                title =
                    "Новый пароль";

                subtitle =
                    "Создайте новый пароль для вашего аккаунта.";
            }

            if (recoveryStep == 4)
            {
                title =
                    "Пароль изменён";

                subtitle =
                    "Ваш пароль был успешно изменён.";
            }
        }


        else if (currentLanguage == "he")
        {
            securityText =
                "שחזור מאובטח";

            emailLabel =
                "אימייל";

            emailPlaceholder =
                "הכנס אימייל";

            sendCodeButtonText =
                "שלח קוד";

            codeLabel =
                "קוד אימות";

            codePlaceholder =
                "הכנס קוד בן 6 ספרות";

            verifyCodeButtonText =
                "אמת קוד";

            newPasswordLabel =
                "סיסמה חדשה";

            newPasswordPlaceholder =
                "הכנס סיסמה חדשה";

            confirmPasswordLabel =
                "אימות סיסמה חדשה";

            confirmPasswordPlaceholder =
                "הכנס שוב את הסיסמה החדשה";

            changePasswordButtonText =
                "שנה סיסמה";

            backToLoginText =
                "חזרה להתחברות ←";

            loginNowText =
                "עבור להתחברות";


            if (recoveryStep == 1)
            {
                title =
                    "איפוס סיסמה";

                subtitle =
                    "הכנס את האימייל שלך כדי לקבל קוד אימות.";
            }

            if (recoveryStep == 2)
            {
                title =
                    "אימות קוד";

                subtitle =
                    "הכנס את קוד האימות בן 6 הספרות.";
            }

            if (recoveryStep == 3)
            {
                title =
                    "סיסמה חדשה";

                subtitle =
                    "צור סיסמה חדשה לחשבון שלך.";
            }

            if (recoveryStep == 4)
            {
                title =
                    "הסיסמה שונתה";

                subtitle =
                    "הסיסמה שלך שונתה בהצלחה.";
            }
        }


        else
        {
            securityText =
                "SECURE RECOVERY";

            emailLabel =
                "Email";

            emailPlaceholder =
                "Enter your email";

            sendCodeButtonText =
                "Send Code";

            codeLabel =
                "Verification Code";

            codePlaceholder =
                "Enter 6-digit code";

            verifyCodeButtonText =
                "Verify Code";

            newPasswordLabel =
                "New Password";

            newPasswordPlaceholder =
                "Enter new password";

            confirmPasswordLabel =
                "Confirm New Password";

            confirmPasswordPlaceholder =
                "Enter new password again";

            changePasswordButtonText =
                "Change Password";

            backToLoginText =
                "← Back to Login";

            loginNowText =
                "Go to Login";


            if (recoveryStep == 1)
            {
                title =
                    "Reset Password";

                subtitle =
                    "Enter your email to receive a verification code.";
            }

            if (recoveryStep == 2)
            {
                title =
                    "Verify Code";

                subtitle =
                    "Enter the 6-digit verification code.";
            }

            if (recoveryStep == 3)
            {
                title =
                    "New Password";

                subtitle =
                    "Create a new password for your account.";
            }

            if (recoveryStep == 4)
            {
                title =
                    "Password Changed";

                subtitle =
                    "Your password was changed successfully.";
            }
        }
    }


    // ==========================================
    // STEP 1
    // REQUEST RESET CODE
    // ==========================================

    private async Task RequestResetCode()
    {
        message = "";


        try
        {
            var request = new
            {
                action =
                    "forgot_password_request",

                email = email
            };


            string json =
                JsonSerializer.Serialize(
                    request
                );


            var socket =
                new ClientSocket();


            string response =
                await socket.SendAsync(
                    json
                );


            var data =
                JsonSerializer.Deserialize<SocketResponse>(
                    response,
                    new JsonSerializerOptions
                    {
                        PropertyNameCaseInsensitive =
                            true
                    }
                );


            if (data?.Success == true)
            {
                // Переходим с Email
                // на экран ввода Code.
                recoveryStep = 2;

                ChangeLanguage();


                // Пока Email-сервис ещё не подключён,
                // настоящий Code находится
                // в консоли Server.
                if (currentLanguage == "ru")
                {
                    message =
                        "Код подтверждения создан. В текущей версии проекта посмотрите его в консоли Server.";
                }

                else if (currentLanguage == "he")
                {
                    message =
                        "קוד האימות נוצר. בגרסה הנוכחית ניתן לראות אותו בקונסולת השרת.";
                }

                else
                {
                    message =
                        "Verification code created. In the current version, check the Server console.";
                }
            }

            else
            {
                ShowServerError();
            }
        }

        catch
        {
            ShowConnectionError();
        }
    }


    // ==========================================
    // STEP 2
    // VERIFY CODE
    // ==========================================

    private async Task VerifyCode()
    {
        message = "";


        try
        {
            var request = new
            {
                action =
                    "forgot_password_verify",

                email = email,

                code = code
            };


            string json =
                JsonSerializer.Serialize(
                    request
                );


            var socket =
                new ClientSocket();


            string response =
                await socket.SendAsync(
                    json
                );


            var data =
                JsonSerializer.Deserialize<SocketResponse>(
                    response,
                    new JsonSerializerOptions
                    {
                        PropertyNameCaseInsensitive =
                            true
                    }
                );


            // Код правильный.
            if (data?.Success == true)
            {
                recoveryStep = 3;

                ChangeLanguage();

                message = "";

                return;
            }


            // Код неправильный.
            if (data?.Message ==
                "Invalid reset code")
            {
                if (currentLanguage == "ru")
                {
                    message =
                        "Неверный код подтверждения.";
                }

                else if (currentLanguage == "he")
                {
                    message =
                        "קוד האימות שגוי.";
                }

                else
                {
                    message =
                        "Invalid verification code.";
                }

                return;
            }


            // Код просрочен.
            if (data?.Message ==
                "Reset code expired")
            {
                if (currentLanguage == "ru")
                {
                    message =
                        "Срок действия кода закончился.";
                }

                else if (currentLanguage == "he")
                {
                    message =
                        "תוקף קוד האימות פג.";
                }

                else
                {
                    message =
                        "Verification code expired.";
                }

                return;
            }


            ShowServerError();
        }

        catch
        {
            ShowConnectionError();
        }
    }


    // ==========================================
    // STEP 3
    // CHANGE PASSWORD
    // ==========================================

    private async Task ResetPassword()
    {
        message = "";


        // Два Password должны совпадать.
        if (newPassword != confirmPassword)
        {
            if (currentLanguage == "ru")
            {
                message =
                    "Пароли не совпадают.";
            }

            else if (currentLanguage == "he")
            {
                message =
                    "הסיסמאות אינן תואמות.";
            }

            else
            {
                message =
                    "Passwords do not match.";
            }

            return;
        }


        // Минимум 6 символов.
        if (newPassword.Length < 6)
        {
            if (currentLanguage == "ru")
            {
                message =
                    "Пароль должен содержать минимум 6 символов.";
            }

            else if (currentLanguage == "he")
            {
                message =
                    "הסיסמה חייבת להכיל לפחות 6 תווים.";
            }

            else
            {
                message =
                    "Password must contain at least 6 characters.";
            }

            return;
        }


        try
        {
            var request = new
            {
                action =
                    "forgot_password_reset",

                email = email,

                code = code,

                newPassword = newPassword
            };


            string json =
                JsonSerializer.Serialize(
                    request
                );


            var socket =
                new ClientSocket();


            string response =
                await socket.SendAsync(
                    json
                );


            var data =
                JsonSerializer.Deserialize<SocketResponse>(
                    response,
                    new JsonSerializerOptions
                    {
                        PropertyNameCaseInsensitive =
                            true
                    }
                );


            if (data?.Success == true)
            {
                // Успешно.
                recoveryStep = 4;


                // Очищаем секретные данные.
                code = "";
                newPassword = "";
                confirmPassword = "";


                ChangeLanguage();

                message = "";

                return;
            }


            if (data?.Message ==
                "Reset code expired")
            {
                if (currentLanguage == "ru")
                {
                    message =
                        "Срок действия кода закончился.";
                }

                else if (currentLanguage == "he")
                {
                    message =
                        "תוקף קוד האימות פג.";
                }

                else
                {
                    message =
                        "Verification code expired.";
                }

                return;
            }


            ShowServerError();
        }

        catch
        {
            ShowConnectionError();
        }
    }


    // ==========================================
    // ERRORS
    // ==========================================

    private void ShowConnectionError()
    {
        if (currentLanguage == "ru")
        {
            message =
                "Не удалось подключиться к серверу.";
        }

        else if (currentLanguage == "he")
        {
            message =
                "לא ניתן להתחבר לשרת.";
        }

        else
        {
            message =
                "Cannot connect to server.";
        }
    }


    private void ShowServerError()
    {
        if (currentLanguage == "ru")
        {
            message =
                "Ошибка сервера.";
        }

        else if (currentLanguage == "he")
        {
            message =
                "שגיאת שרת.";
        }

        else
        {
            message =
                "Server error.";
        }
    }


    // ==========================================
    // SERVER RESPONSE
    // ==========================================

    private class SocketResponse
    {
        public bool Success { get; set; }

        public int Status { get; set; }

        public string Message { get; set; } = "";
    }
}