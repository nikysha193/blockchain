@page "/forgot-password"
@rendermode InteractiveServer

@inject AppState AppState

<PageTitle>Forgot Password</PageTitle>


<!-- ========================================= -->
<!-- SETTINGS -->
<!-- ========================================= -->

<div class="top-controls">

    <div class="settings-capsule @(showSettingsMenu ? "open" : "")">

        <!-- Содержимое раскрывающейся панели -->
        <div class="settings-capsule-content">

            <!-- Light / Dark -->
            <div class="theme-segment">

                <!-- Light Mode -->
                <button type="button"
                        class="theme-choice @(!darkTheme ? "active" : "")"
                        @onclick="SetLightTheme">

                    <span class="sun-icon">☀</span>

                </button>


                <!-- Dark Mode -->
                <button type="button"
                        class="theme-choice @(darkTheme ? "active" : "")"
                        @onclick="SetDarkTheme">

                    <span class="moon-icon">☾</span>

                </button>

            </div>


            <div class="settings-divider"></div>


            <!-- Language -->
            <select class="settings-language-select"
                    @bind="currentLanguage"
                    @bind:after="ChangeLanguage">

                <option value="en">English</option>
                <option value="ru">Русский</option>
                <option value="he">עברית</option>

            </select>

        </div>


        <!-- Settings button -->
        <button type="button"
                class="settings-gear-button"
                @onclick="ToggleSettingsMenu">

            <svg class="settings-gear-icon"
                 viewBox="0 0 24 24"
                 fill="none">

                <path d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 0 0 2.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 0 0 1.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 0 0-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 0 0-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 0 0-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 0 0-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35A1.724 1.724 0 0 0 5.382 7.75c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.573-1.066Z"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round" />

                <path d="M12 15.25A3.25 3.25 0 1 0 12 8.75a3.25 3.25 0 0 0 0 6.5Z"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round" />

            </svg>

        </button>

    </div>

</div>


<!-- ========================================= -->
<!-- FORGOT PASSWORD PAGE -->
<!-- ========================================= -->

<div class="auth-layout @(darkTheme ? "dark" : "")">

    <!-- Blockchain decoration -->
    <div class="blockchain-art" aria-hidden="true">

        <div class="chain-block block-one">01</div>

        <div class="chain-line"></div>

        <div class="chain-block block-two">02</div>

        <div class="chain-line"></div>

        <div class="chain-block block-three">03</div>

    </div>


    <!-- Forgot Password card -->
    <div class="login-container">

        <div class="security-badge">

            <span class="security-icon">◇</span>

            <span>@securityText</span>

        </div>


        <h1>@title</h1>

        <p class="subtitle">
            @subtitle
        </p>


        <form @onsubmit="ContinueRecovery"
              @onsubmit:preventDefault="true">

            <!-- RTL только для Email -->
            <label for="email"
                   dir="@(currentLanguage == "he" ? "rtl" : "ltr")">
                @emailLabel
            </label>

            <input type="email"
                   id="email"
                   @bind="email"
                   dir="@(currentLanguage == "he" ? "rtl" : "ltr")"
                   placeholder="@emailPlaceholder"
                   required />


            <button id="resetButton"
                    type="submit">
                @continueButtonText
            </button>

        </form>


        <p id="message">@message</p>


        <p class="switch-page">

            <a href="/">
                @backToLoginText
            </a>

        </p>

    </div>

</div>


@code
{
    // ==========================================
    // LANGUAGE
    // ==========================================

    // Язык хранится в общем AppState.
    private string currentLanguage
    {
        get => AppState.Language;
        set => AppState.Language = value;
    }


    // ==========================================
    // THEME
    // ==========================================

    // Тема хранится в общем AppState.
    private bool darkTheme
    {
        get => AppState.DarkTheme;
        set => AppState.DarkTheme = value;
    }


    // Показывает или скрывает Settings Capsule.
    private bool showSettingsMenu = false;


    // ==========================================
    // FORM DATA
    // ==========================================

    // Email, который вводит пользователь.
    private string email = "";


    // ==========================================
    // MESSAGE
    // ==========================================

    private string message = "";


    // ==========================================
    // PAGE TEXT
    // ==========================================

    private string securityText = "SECURE RECOVERY";

    private string title = "Reset Password";

    private string subtitle =
        "Enter your email. After confirming the verification code, you will be able to set a new password.";

    private string emailLabel = "Email";

    private string emailPlaceholder = "Enter your email";

    private string continueButtonText = "Continue";

    private string backToLoginText = "← Back to Login";


    // ==========================================
    // PAGE START
    // ==========================================

    // Вызывается автоматически при открытии страницы.
    protected override void OnInitialized()
    {
        // Сразу применяем язык из AppState.
        ChangeLanguage();
    }


    // ==========================================
    // SETTINGS
    // ==========================================

    // Открывает или закрывает Settings Capsule.
    private void ToggleSettingsMenu()
    {
        showSettingsMenu = !showSettingsMenu;
    }


    // Включает Light Mode.
    private void SetLightTheme()
    {
        darkTheme = false;
    }


    // Включает Dark Mode.
    private void SetDarkTheme()
    {
        darkTheme = true;
    }


    // ==========================================
    // LANGUAGE
    // ==========================================

    private void ChangeLanguage()
    {
        if (currentLanguage == "ru")
        {
            securityText = "БЕЗОПАСНОЕ ВОССТАНОВЛЕНИЕ";

            title = "Восстановление пароля";

            subtitle =
                "Введите ваш email. После подтверждения кода вы сможете установить новый пароль.";

            emailLabel = "Электронная почта";

            emailPlaceholder = "Введите ваш email";

            continueButtonText = "Продолжить";

            backToLoginText = "← Назад ко входу";
        }

        else if (currentLanguage == "he")
        {
            securityText = "שחזור מאובטח";

            title = "איפוס סיסמה";

            subtitle =
                "הכנס את האימייל שלך. לאחר אישור הקוד תוכל להגדיר סיסמה חדשה.";

            emailLabel = "אימייל";

            emailPlaceholder = "הכנס אימייל";

            continueButtonText = "המשך";

            backToLoginText = "חזרה להתחברות ←";
        }

        else
        {
            securityText = "SECURE RECOVERY";

            title = "Reset Password";

            subtitle =
                "Enter your email. After confirming the verification code, you will be able to set a new password.";

            emailLabel = "Email";

            emailPlaceholder = "Enter your email";

            continueButtonText = "Continue";

            backToLoginText = "← Back to Login";
        }


        // После смены языка убираем старое сообщение.
        message = "";
    }


    // ==========================================
    // RECOVERY
    // ==========================================

    private void ContinueRecovery()
    {
        if (currentLanguage == "ru")
        {
            message =
                "Позже восстановление будет подключено к серверу.";
        }

        else if (currentLanguage == "he")
        {
            message =
                "מערכת השחזור תחובר לשרת בהמשך.";
        }

        else
        {
            message =
                "Recovery system will be connected to the server later.";
        }
    }
}