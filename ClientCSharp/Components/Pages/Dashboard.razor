    private string username = "";

    private string sessionToken = "";

    private bool showAccountMenu = false;


    // =====================================================
    // PAGE START
    // =====================================================

    protected override async Task OnInitializedAsync()
    {
        var authenticationState =
            await AuthenticationStateProvider
                .GetAuthenticationStateAsync();


        var user =
            authenticationState.User;


        // Если пользователь не вошёл,
        // отправляем его на Login.
        if (user.Identity?.IsAuthenticated != true)
        {
            NavigationManager.NavigateTo(
                "/login",
                forceLoad: true
            );

            return;
        }


        username =
            user.Identity?.Name ?? "";


        sessionToken =
            user.FindFirst(
                "sessionToken"
            )?.Value ?? "";


        // Если осталась старая Cookie,
        // в которой ещё нет Session Token,
        // делаем нормальный Logout.
        if (string.IsNullOrWhiteSpace(
                sessionToken
            ))
        {
            NavigationManager.NavigateTo(
                "/auth/logout",
                forceLoad: true
            );

            return;
        }
    }



    // =====================================================
    // ACCOUNT
    // =====================================================

    private string GetUserLetter()
    {
        if (string.IsNullOrWhiteSpace(
                username
            ))
        {
            return "?";
        }


        return username
            .Substring(0, 1)
            .ToUpper();
    }


